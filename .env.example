# Redis (local values match the redis-http service in docker-compose.yml)
REDIS_URL=http://localhost:8079
REDIS_TOKEN=local-dev-token

# Database (local values match the db service in docker-compose.yml)
DB_PASSWORD=local-dev-password
DB_USER=postgres
DB_NAME=oauth_template
DB_HOST=localhost

# OAuth
# The replace-me values let the app, migrations, and tests start without OAuth apps.
# Replace them with your own app credentials to use GitHub or Discord sign-in.
OAUTH_REDIRECT_URL_BASE=http://localhost:3000/api/oauth/

# Discord
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me

# GitHub
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
